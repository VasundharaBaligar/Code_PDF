# Optional: GitHub personal access token, only needed if you re-run ingestion
# often and hit the 60 requests/hour unauthenticated limit. Not required for
# normal use since ingestion runs once.
GITHUB_TOKEN=

# Ollama connection settings (defaults match a local `ollama serve`).
# Always the fallback — used automatically whenever Groq isn't configured
# or fails, so the app works with zero external accounts.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Groq: free tier, no credit card, get a key at https://console.groq.com/keys
# Tried first if set. Leave blank to run fully local via Ollama only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
